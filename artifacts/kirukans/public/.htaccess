<IfModule mod_rewrite.c>
  RewriteEngine On

  # The static bundle has no API server; do not send API requests to the SPA.
  RewriteRule ^api(?:/|$) - [L]

  # Serve real files and directories as usual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let the frontend router handle client-side routes.
  RewriteRule ^ index.html [L]
</IfModule>
