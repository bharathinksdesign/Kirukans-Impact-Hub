# Reference only. Set real values in Hostinger's private environment settings;
# never commit a populated environment file.

# The Hostinger start command sets NODE_ENV, HOSTINGER_DEPLOYMENT, and
# SERVE_FRONTEND. The host supplies PORT.
#
# Required for the API:
# DATABASE_URL=
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_APP_URL=
# INBOX_ADMIN_EMAIL=
#
# Required before building the frontend:
# VITE_CLERK_PUBLISHABLE_KEY=
# Optional before building:
# VITE_WHATSAPP_COMMUNITY_URL=
# VITE_CLERK_PROXY_URL should be unset for external Clerk hosting.
